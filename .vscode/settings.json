{
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/.next": true,
        "**/node_modules": true,
        "**/.turbo": true
    },
    "search.exclude": {
        "**/.next": true,
        "**/node_modules": true,
        "**/.turbo": true
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    }
}